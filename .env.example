# Spicy Link Generator — environment variables
# Copy to .env for local use (npm run dev loads it when supported), or set these in
# Vercel → Settings → Environment Variables. Never commit real credentials.

# No recipient to configure: the 6-digit code is emailed to the address that asked for it
# (the person signing in). The allowed-domain list below is the only gate.

# Only these email domains may sign in (comma-separated). The legacy single-value
# ALLOWED_DOMAIN is still honoured if ALLOWED_DOMAINS is not set.
ALLOWED_DOMAINS=bcflights.com,travelbusinessclass.com

# Required for real sign-in emails. Set this in Vercel for Production, Preview,
# and Development as appropriate. Never put a real key in this committed file.
RESEND_API_KEY=

# Quick test sender: this works only for the email address associated with your Resend account.
# Because sign-in codes now go to real users, production needs a verified domain: add your
# domain in Resend and point FROM_EMAIL at it
# (for example: "Spicy Link Generator <login@bcflights.com>").
#
# If FROM_EMAIL is left empty the app sends from the first ALLOWED_DOMAINS entry
# (e.g. "Spicy Link Generator <login@bcflights.com>") instead of the resend.dev sandbox
# address. That is deliberate: onboarding@resend.dev can ONLY email the address your Resend
# account is registered to, so sign-in codes sent from it are rejected — which is the
# "You can only send testing emails to your own email address" error on the login page.
# Verify the sending domain at https://resend.com/domains (add the DNS records it shows),
# then set FROM_EMAIL to an address on that domain.
FROM_EMAIL=Spicy Link Generator <onboarding@resend.dev>

# Signs the login tokens and the session cookie. IMPORTANT: generate your own before the
# repo is public — whoever knows this value can mint a session cookie and skip the code:
#   openssl rand -hex 32
AUTH_SECRET=

# Set to 1 for local debugging only. The local server then shows the code in its response.
# DEV_MODE=1
