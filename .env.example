# Spicy Link Generator — environment variables (all optional, sensible defaults are built in)
# Copy to .env for local use (npm run dev loads it automatically), or set these in
# Vercel → Settings → Environment Variables for production.

# Who receives the 6-digit code for every login attempt.
APPROVER_EMAIL=adhambadraan@icloud.com

# Only this domain may sign in.
ALLOWED_DOMAIN=bcflights.com

# Resend. A working key is already the built-in default; set this to override it.
RESEND_API_KEY=re_eEa6fVKg_KEBocyJ2fNUQxaoCPXVg4J6H

# "onboarding@resend.dev" works with zero DNS setup but can only deliver to your own
# Resend account email. Once bcflights.com is verified in Resend → Domains, switch to:
#   FROM_EMAIL=Spicy Link Generator <login@bcflights.com>
FROM_EMAIL=Spicy Link Generator <onboarding@resend.dev>

# Signs the login tokens and the session cookie. IMPORTANT: generate your own before the
# repo is public — whoever knows this value can mint a valid session and skip the code:
#   openssl rand -hex 32
AUTH_SECRET=

# Set to 1 to make api/request-code.js return the code in the response (local debugging only).
# DEV_MODE=1
