# Spicy Link Generator — environment variables
# Copy to .env for local use (npm run dev loads it when supported), or set these in
# Vercel → Settings → Environment Variables. Never commit real credentials.

# Who receives the 6-digit code for every sign-in attempt. The approval email shows the name
# and address of the person asking, and the approver passes the code on to them — nothing is
# ever emailed to the person signing in.
#
# The default below is what makes the default sender work: Resend's shared sender
# (onboarding@resend.dev) can only deliver to the address its account is registered to, and
# the approver inbox is normally that address. Set APPROVER_EMAIL to a different inbox if you
# want to approve from somewhere else ("none" switches the relay off entirely).
APPROVER_EMAIL=adhambadraan@gmail.com

# Only these email domains may sign in (comma-separated). The legacy single-value
# ALLOWED_DOMAIN is still honoured if ALLOWED_DOMAINS is not set.
ALLOWED_DOMAINS=bcflights.com,travelbusinessclass.com

# Required for real approval emails. Set this in Vercel for Production, Preview,
# and Development as appropriate. Never put a real key in this committed file.
RESEND_API_KEY=

# Sender of the sign-in emails. Leave this unset (or as below) to send from Resend's shared
# address onboarding@resend.dev. The sender is NEVER derived from ALLOWED_DOMAINS — those
# only decide who may sign in.
#
# Resend only lets onboarding@resend.dev deliver to the address your Resend account is
# registered to, which is exactly the approver inbox above — that pairing is the zero-setup
# default and needs no DNS records. If you change APPROVER_EMAIL to some other inbox, verify a
# domain at https://resend.com/domains (add the DNS records it shows) and set FROM_EMAIL to an
# address on it, e.g. "Spicy Link Generator <login@bcflights.com>".
#
# Confirm delivery any time by opening /api/health?send=1 — it mails a test (no code) to the
# approver inbox and reports exactly what Resend said.
FROM_EMAIL=Spicy Link Generator <onboarding@resend.dev>

# Signs the login tokens and the session cookie. IMPORTANT: generate your own before the
# repo is public — whoever knows this value can mint a session cookie and skip the code:
#   openssl rand -hex 32
AUTH_SECRET=

# ── Special access (no OTP) ────────────────────────────────────────────────────────────────
# A few named inboxes sign in with a fixed 6-digit access PIN instead of an emailed OTP: they
# enter their address, get no email, and type their PIN. Built-in defaults live in
# lib/special-access.js (frank@ / lamar@ / dex@ / lucy@ bcflights.com).
#
# SPECIAL_ACCESS_PINS replaces that built-in list outright. Syntax: address=pin pairs separated
# by commas (":" works as the separator too). Anything malformed is ignored, so a typo falls
# back to the defaults rather than becoming a working guess.
#   SPECIAL_ACCESS_PINS=frank@bcflights.com=123456,lucy@bcflights.com=654321
#
# Rotate a PIN by setting it here — that value wins over the committed default, so you do not
# need a code change, and the new value never enters git history.
#
# SECURITY: this repository is public, so the built-in defaults are readable by anyone and stay
# in git history forever. A 6-digit PIN is only 1,000,000 combinations, so the real defence is
# the per-inbox lockout in lib/special-access.js (10 wrong PINs → 15 minutes), which is
# in-memory per instance and therefore a speed bump rather than a wall. Set your own
# SPECIAL_ACCESS_PINS, and set SPECIAL_ACCESS=off to switch the bypass off completely — those
# inboxes then fall back to the normal OTP approval flow.
# SPECIAL_ACCESS=off
# SPECIAL_ACCESS_PINS=

# Set to 1 for local debugging only. The local server then shows the code in its response.
# DEV_MODE=1
