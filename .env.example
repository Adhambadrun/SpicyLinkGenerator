# Spicy Link Generator — environment variables
# Copy to .env for local use (npm run dev loads it when supported), or set these in
# Vercel → Settings → Environment Variables. Never commit real credentials.

# Who receives the 6-digit code for every login attempt.
APPROVER_EMAIL=adhambadraan@gmail.com

# Only this domain may sign in.
ALLOWED_DOMAIN=bcflights.com

# Required for real approval emails in production. Create a fresh key in Resend → API Keys.
# The old key must not be reused: it was exposed in the public repository.
RESEND_API_KEY=

# Quick test sender: this works only for the email address associated with your Resend account.
# For production, verify your domain in Resend and set FROM_EMAIL to that domain instead
# (for example: "Spicy Link Generator <login@bcflights.com>").
FROM_EMAIL=Spicy Link Generator <onboarding@resend.dev>

# Signs the login tokens and the session cookie. IMPORTANT: generate your own before the
# repo is public — whoever knows this value can mint a session cookie and skip approval:
#   openssl rand -hex 32
AUTH_SECRET=

# Set to 1 for local debugging only. The local server then shows the code in its response.
# DEV_MODE=1
