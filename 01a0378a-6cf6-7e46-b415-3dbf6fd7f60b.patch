+  var tab = false;
+  try{ tab = sessionStorage.getItem('slg_tab') === '1'; }catch(e){}
+  if(!tab){ toLogin(); return; }
+
+  var lastActive = Date.now();
+  try{ lastActive = parseInt(sessionStorage.getItem('slg_active'), 10) || lastActive; }catch(e){}
+  function poke(){ lastActive = Date.now(); try{ sessionStorage.setItem('slg_active', String(lastActive)); }catch(e){} }
